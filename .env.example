# PostHog project API key (Project settings -> Project API key). Safe to expose:
# it is write-only and cannot read data back out.
#
# There is deliberately no host variable. Ingestion goes through the `/relay`
# proxy declared in `next.config.ts`, and the real PostHog origin is set there.
#
# Unset means analytics is a no-op — `instrumentation-client.ts` skips init
# entirely — so the site runs fine without it.
NEXT_PUBLIC_POSTHOG_KEY=


# --- Supabase -------------------------------------------------------------
#
# Where the contact form and the report gate write. Apply the migrations in
# `supabase/migrations/` before either will work — `pnpm supabase db push` for a
# linked remote, `pnpm supabase db reset` for the local stack.
#
# Neither of these is `NEXT_PUBLIC_`, and that is the security model rather than
# an oversight: there is no browser Supabase client on this site. Every write
# goes through a Server Action, and the report PDFs are public storage objects
# that need no key to fetch — so the server key is the only key that exists.
#
# **There is deliberately no publishable key** (`sb_publishable_…`). Nothing on
# the client talks to Supabase, so adding one would ship an unused credential to
# every visitor. Add it only alongside a real browser client, never ahead of one.
#
# Settings -> Data API -> Project URL. Also in the Connect dialog.
SUPABASE_URL=
# Settings -> API Keys -> Secret keys (`sb_secret_…`). This is the replacement
# for the legacy `service_role` key and carries the same `BYPASSRLS` attribute:
# it skips every row-level security policy, which is exactly why the tables in
# `supabase/migrations/` can have none.
#
# Never expose it, never prefix it `NEXT_PUBLIC_`, never send it to a client.
# If it leaks, rotate it in the dashboard — secret keys revoke individually,
# which is the main practical gain over the old `service_role` JWT.
SUPABASE_SECRET_KEY=

# Generate with:  openssl rand -hex 32
#
# Submitter IPs are hashed with this and the raw address is never stored. It has
# to be secret and it has to be long: an unsalted IP hash is an IP, because the
# address space is small enough to enumerate exhaustively in seconds. Hex rather
# than base64 so there is no `+`, `/`, or `=` to confuse a .env parser.
#
# Changing it resets every rate-limit window. Unset, the limiter stands down
# rather than storing a bare address — see `lib/forms.server.ts`.
RF_IP_SALT=


# --- Resend ---------------------------------------------------------------
#
# Notification mail for contact submissions. The account is held directly with
# Resend — resend.com -> API Keys. Not through an integration or a reseller, so
# nothing here is tied to a particular host.
#
# Both unset is a supported state: submissions are still recorded in Supabase and
# the send is skipped with a warning. Delivery is best-effort by design.
RESEND_API_KEY=
# An address on a domain verified in Resend (Domains -> Add Domain, then the DNS
# records it gives you). The sandbox sender only delivers to the account owner,
# so this has to be a real address on the verified domain for mail to arrive.
RESEND_FROM=
