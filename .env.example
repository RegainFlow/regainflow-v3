# PostHog — analytics. Copy to `.env.local` and fill in.
#
# Without NEXT_PUBLIC_POSTHOG_KEY the SDK never initialises and the site behaves
# exactly as it did before analytics were added, so local development needs no
# setup. Set both in Vercel for the deployed environments.
#
# The project key is the "Project API Key" in PostHog under Settings → Project.
# It is a publishable key and is expected to be visible in the browser.
NEXT_PUBLIC_POSTHOG_KEY=

# Region host. Use https://eu.i.posthog.com for an EU project — `next.config.ts`
# reads this at build time to point the /ingest rewrite at the matching region,
# so it must be set at build time, not only at runtime.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
